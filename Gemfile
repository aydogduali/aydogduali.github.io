source "https://rubygems.org"

# Ruby 4.0+ compatibility - these gems were removed from stdlib
gem "logger"
gem "csv"
gem "ostruct"
gem "base64"
gem "bigdecimal"
gem "mutex_m"
gem "drb"

# Jekyll and dependencies
gem "jekyll", "~> 4.3"
gem "webrick" # Required for Jekyll 4.x

# Plugins
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag"
  gem "jekyll-gist"
end

# Theme - use minima or specify the slate theme directly
gem "jekyll-theme-slate"

# Windows timezone support
gem 'tzinfo-data', platforms: [:mingw, :mswin, :jruby]

